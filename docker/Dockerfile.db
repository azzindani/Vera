# Postgres + pgvector + RUM + pg_search.
#
# ! RUM is built from source because no published image carries it. Without it
# the engine still runs — SearchOps::has_rum() probes and falls back to ts_rank
# — but the text arm costs p50 750ms instead of 404ms, and that arm is the
# single most expensive part of a search.
#
# Building it inside a running container works and is what the first
# measurements used, but it dies with the container: `docker compose down`
# takes the extension with it and migration 0003 then fails on CREATE
# EXTENSION. This makes it part of the image instead.
#
#   docker compose build db && docker compose up -d
#
# ! MIGRATING AN EXISTING VOLUME. `pgdata` survives an image swap, so a database
# whose RUM was built in-place from master carries extversion 1.4 in its catalog
# and an index written by 1.4, while this image ships 1.3. Postgres will refuse
# to load the extension rather than read that index with the wrong code. Drop
# and rebuild once, before switching the image:
#
#   DROP INDEX IF EXISTS chunks_tsv_rum;
#   DROP EXTENSION IF EXISTS rum;
#   -- then bring the new image up and re-apply migrations/0003 (~25s)
#
# A fresh volume needs none of this.

ARG PG_MAJOR=16
FROM pgvector/pgvector:pg${PG_MAJOR} AS rum-builder
ARG PG_MAJOR
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential postgresql-server-dev-${PG_MAJOR} curl ca-certificates \
 && rm -rf /var/lib/apt/lists/*
# Pinned to a commit, ✗ master: an extension that silently changes its distance
# function changes every ranking this corpus produces.
ARG RUM_REF=1.3.15
RUN curl -sSL "https://github.com/postgrespro/rum/archive/refs/tags/${RUM_REF}.tar.gz" \
      -o /tmp/rum.tar.gz \
 && tar xzf /tmp/rum.tar.gz -C /tmp \
 && cd "/tmp/rum-${RUM_REF}" \
 && make USE_PGXS=1 \
 && make USE_PGXS=1 install

FROM pgvector/pgvector:pg${PG_MAJOR}
ARG PG_MAJOR
# Only the built artifacts travel; the compiler stays behind.
COPY --from=rum-builder /usr/lib/postgresql/${PG_MAJOR}/lib/rum.so \
                        /usr/lib/postgresql/${PG_MAJOR}/lib/
COPY --from=rum-builder /usr/share/postgresql/${PG_MAJOR}/extension/rum* \
                        /usr/share/postgresql/${PG_MAJOR}/extension/

# pg_search · Tantivy as an index type, for the lexical arm (migration 0004).
#
# ! A .deb, ✗ a source build. pg_search is Rust on pgrx; compiling it needs a
# toolchain and tens of minutes, and ParadeDB publish a package built for this
# exact base — pgvector/pgvector:pg16 is bookworm.
#
# ! Pinned, like RUM above and for the same reason: a scorer that changes
# quietly changes every ranking this corpus produces.
#
# ! Not fatal if it is absent. SearchOps::has_bm25() probes and falls back to
# the sparsevec scan, so the arm still answers — measured 6,282 ms instead of
# 1,858 ms at 5M (docs/HARDWARE.md §6).
ARG PG_SEARCH_REF=0.25.9
ARG PG_SEARCH_DEB=postgresql-16-pg-search_0.25.9-1PARADEDB-bookworm_amd64.deb
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends curl ca-certificates; \
    curl -fsSL -o /tmp/pg_search.deb \
      "https://github.com/paradedb/paradedb/releases/download/v${PG_SEARCH_REF}/${PG_SEARCH_DEB}"; \
    apt-get install -y --no-install-recommends /tmp/pg_search.deb; \
    rm -f /tmp/pg_search.deb; \
    apt-get purge -y --auto-remove curl; \
    rm -rf /var/lib/apt/lists/*

# ! pg_search must be preloaded. Without this, CREATE EXTENSION in migration
# 0004 fails with a message about shared_preload_libraries, which reads like a
# bug rather than a configuration line nobody added.
RUN echo "shared_preload_libraries = 'pg_search'" \
      >> /usr/share/postgresql/postgresql.conf.sample
