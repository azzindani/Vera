# The Vera engine · stateless, HTTP transport.
#
# ! debian-slim, ✗ alpine. The engine links the system allocator and rustls
# through reqwest; musl would mean a different allocator and a rebuild of both,
# for an image that is already ~5 MB of binary.
#
#   docker compose up -d engine

FROM rust:1-bookworm AS builder
WORKDIR /src

# ! Manifests first. Dependencies change far less often than sources, so this
# layer survives almost every rebuild — without it each edit recompiles reqwest.
COPY Cargo.toml Cargo.lock ./
COPY crates/contract/Cargo.toml crates/contract/
COPY crates/embed/Cargo.toml    crates/embed/
COPY crates/engine/Cargo.toml   crates/engine/
COPY crates/mcp/Cargo.toml      crates/mcp/
COPY crates/store/Cargo.toml    crates/store/
RUN mkdir -p crates/contract/src crates/embed/src crates/engine/src \
             crates/mcp/src crates/store/src \
 && echo 'fn main() {}' > crates/mcp/src/main.rs \
 && touch crates/contract/src/lib.rs crates/embed/src/lib.rs \
          crates/engine/src/lib.rs crates/store/src/lib.rs \
 && cargo build --release --locked --workspace 2>/dev/null || true

COPY . .
# ! Touch the real sources: cargo keys off mtime, and the stub main.rs above is
# newer than the files just copied over it.
#
# ! --locked. A container built from a different dependency resolution than CI
# verified is a different artifact wearing the same tag.
RUN touch crates/*/src/lib.rs crates/mcp/src/main.rs \
 && cargo build --release --locked -p vera-mcp

FROM debian:bookworm-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates wget \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --system --uid 10001 vera
COPY --from=builder /src/target/release/vera-mcp /usr/local/bin/vera-mcp

# ! Non-root, and the compose file mounts the root filesystem read-only. The
# query path never writes (CLAUDE.md §5.6) and the container holds no state, so
# there is nothing it needs privileges or a writable disk for.
USER 10001

# ! Transport only. Every other setting is deliberately absent so a missing
# variable fails at startup rather than picking up a default baked into an
# image nobody re-reads. See .env.example.
ENV TRANSPORT=http \
    HTTP_ADDR=0.0.0.0:8081
EXPOSE 8081

# ! No shell form. `ENTRYPOINT vera-mcp` would run it under `/bin/sh -c`, which
# swallows SIGTERM and leaves the orchestrator waiting out its kill timeout on
# every deploy.
ENTRYPOINT ["/usr/local/bin/vera-mcp"]
