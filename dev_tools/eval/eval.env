# The env file eval_corpus.py hands docker compose instead of the operator's `.env`.
#
# ! Plumbing only, no engine knob. A knob left out runs at the default docker-compose.yml
# gives it, so a measurement depends on git and not on whatever an operator's `.env` was
# tuned to: the first run of eval_corpus.py read DENSE_WEIGHT, REGION_WEIGHT and the gate
# floors from a local `.env` and scored Canada 87.7% at 25 against the 88.6% recorded.
# A knob a corpus is measured with goes in its `engine` block in corpora.json.
POSTGRES_USER=vera
POSTGRES_DB=vera
# The `db` service is never started by the eval (corpora.json names each corpus's own
# database); compose still requires a value to read the file.
POSTGRES_PASSWORD=unused-by-the-eval
POSTGRES_PORT=25432
EMBED_ENDPOINT=http://embed:80
BM25_VOCAB=/vocab/corpus.bm25.json
MODEL_DIR=./.test/Qwen3-Embedding-0.6B
