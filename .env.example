# Vera · engine configuration
#
# Copy to `.env` and fill in. Every value below is read at startup and nothing
# is hardcoded in the binary (invariant 12). The three REQUIRED variables have
# no defaults on purpose: each names something outside the process that only
# you know, and a wrong guess fails silently rather than loudly.
#
#   cp .env.example .env && docker compose up -d
#
# docs/CONFIGURATION.md is the full table, including what each dial costs.

# ─── required ────────────────────────────────────────────────────────────────

# Postgres, as a libpq connection string.
POSTGRES_USER=vera
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vera
DATABASE_URL=host=db port=5432 dbname=vera user=vera password=change-me

# The embedding server. Must serve the same weights, pooling and normalization
# the corpus was embedded with — the startup canary re-embeds a stored chunk
# and refuses to serve if the vectors land somewhere else.
EMBED_ENDPOINT=http://embed:80

# The BM25 vocabulary built alongside this corpus.
#
# ! Sparse vectors are indexed by vocabulary POSITION. Serving a corpus against
# another run's vocabulary compares unrelated dimensions and returns plausible
# nonsense rather than failing.
BM25_VOCAB=/vocab/corpus.bm25.json

# Local model weights, mounted read-only into the embedding container.
MODEL_DIR=./.test/Qwen3-Embedding-0.6B

# Directory holding BM25_VOCAB, mounted read-only into the engine.
VOCAB_DIR=./.test/runs

# ─── transport ───────────────────────────────────────────────────────────────

TRANSPORT=http           # stdio | http
HTTP_ADDR=0.0.0.0:8081

# ─── concurrency · the OOM guarantee ─────────────────────────────────────────
#
# Peak RAM = fixed cost + (MAX_CONCURRENCY × one cluster). Raising this raises
# the container's memory limit: the two are one decision, ✗ two.

MAX_CONCURRENCY=4
QUEUE_WAIT_MS=2000       # a bound on TIME as well as on queue depth

# ─── retrieval dials ─────────────────────────────────────────────────────────

CLUSTERS_PROBED=5        # layer-2 probe width · recall vs latency
PER_CLUSTER_K=20
PER_ARM_K=20
TOP_K=10
SNIPPET_CHARS=280

# ─── fusion weights ──────────────────────────────────────────────────────────
#
# ! Properties of the CORPUS, not of the engine, and re-measured after every
# re-chunk. The shipped defaults were fitted on spike-02; a different corpus
# needs its own fit (dev_tools/eval/e2e.py reports it).

DENSE_WEIGHT=0.0
SPARSE_WEIGHT=1.0
TEXT_WEIGHT=1.0

# ─── gates ───────────────────────────────────────────────────────────────────

CANARY_MIN_COSINE=0.98   # startup vector-space check; loosening it is visible
DOMAIN_FLOOR=0.45
DOMAIN_LEXICAL_FLOOR=0.40
GATE_SAMPLE=5

# ─── response caps ───────────────────────────────────────────────────────────

READ_CHUNK_CHARS=4000
MAX_PROVENANCE_IDS=50

# ─── infrastructure · read by docker-compose, not by the engine ──────────────
#
# All optional; the defaults shown are what compose falls back to. Documented
# in full in docs/CONFIGURATION.md §8.

# POSTGRES_PORT=5432                  # published on 127.0.0.1 only
# PG_SHARED_BUFFERS=1500MB            # the VPS overlay drops this to 512MB
# PG_EFFECTIVE_CACHE_SIZE=4GB
# PG_MAINTENANCE_WORK_MEM=512MB
# PG_WORK_MEM=32MB
# PG_MAX_CONNECTIONS=32

# EMBED_IMAGE=ghcr.io/huggingface/text-embeddings-inference:86-1.7.2
# EMBED_POOLING=last-token            # must match the model's 1_Pooling/config.json
# EMBED_DTYPE=float16
# EMBED_MAX_BATCH_TOKENS=32768        # the model's full context
# EMBED_PORT=8080

# ENGINE_BIND=127.0.0.1               # ! 0.0.0.0 publishes the corpus
# ENGINE_PORT=8081
# VPS_CPUSET=0,1                      # overlay only; db and engine share a pair
