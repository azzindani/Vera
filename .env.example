# Vera · engine configuration
#
# Copy to `.env` and fill in. Every value below is read at startup and nothing
# is hardcoded in the binary (invariant 12). The three REQUIRED variables have
# no defaults on purpose: each names something outside the process that only
# you know, and a wrong guess fails silently rather than loudly.
#
#   cp .env.example .env && docker compose up -d
#
# docs/CONFIGURATION.md is the full table, including what each dial costs.

# ─── required ────────────────────────────────────────────────────────────────

# Postgres, as a libpq connection string.
POSTGRES_USER=vera
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vera
DATABASE_URL=host=db port=5432 dbname=vera user=vera password=change-me

# The embedding server. Must serve the same weights, pooling and normalization
# the corpus was embedded with — the startup canary re-embeds a stored chunk
# and refuses to serve if the vectors land somewhere else.
EMBED_ENDPOINT=http://embed:80

# The BM25 vocabulary built alongside this corpus.
#
# ! Sparse vectors are indexed by vocabulary POSITION. Serving a corpus against
# another run's vocabulary compares unrelated dimensions and returns plausible
# nonsense rather than failing.
BM25_VOCAB=/vocab/corpus.bm25.json

# Local model weights, mounted read-only into the embedding container.
MODEL_DIR=./.test/Qwen3-Embedding-0.6B

# Directory holding BM25_VOCAB, mounted read-only into the engine.
VOCAB_DIR=./.test/runs

# ─── transport ───────────────────────────────────────────────────────────────

TRANSPORT=http           # stdio | http
HTTP_ADDR=0.0.0.0:8081

# ─── concurrency · the OOM guarantee ─────────────────────────────────────────
#
# Peak RAM = fixed cost + (MAX_CONCURRENCY × one cluster). Raising this raises
# the container's memory limit: the two are one decision, ✗ two.

MAX_CONCURRENCY=4
QUEUE_WAIT_MS=2000       # a bound on TIME as well as on queue depth

# ─── retrieval dials ─────────────────────────────────────────────────────────

CLUSTERS_PROBED=5        # layer-2 probe width · recall vs latency

# How many probed clusters go into ONE statement.
#
# ! A LATENCY knob, ✗ a memory one. Measured engine peak RSS at 1 / 2 / 5 is
# 14 / 12 / 14 MB -- flat (docs/HARDWARE.md §6a). The engine never receives a
# vector: arms return (id, score) under a LIMIT and Postgres does the scanning,
# so the cluster-sized working set is the DATABASE's, not this process's.
#
# 5 is worth -182 ms p50; 2 is worth nothing (+7 ms). There is no gradient here,
# only 1 and >= CLUSTERS_PROBED.
#
# 1 is the default because every published number was taken at it. Raising it is
# safe on the evidence in hand; what is NOT measured is the database side, so
# change it deliberately and re-measure (docs/OPERATIONS.md §5).
CLUSTER_BATCH=1
PER_CLUSTER_K=20
PER_ARM_K=20
TOP_K=10
CANDIDATE_POOL=60        # metadata fetched for this many, not TOP_K; must be >= TOP_K

# Sibling expansion · only runs when a caller passes expand: ["siblings"].
# Bounds one walk: seeds x per-seed rows. p50 is 22 chunks per regulation and
# p95 is 210, so 5 x 40 takes the common case whole and bounds the tail.
EXPAND_SEEDS=5           # top-ranked candidates walked from, de-duplicated by regulation
EXPAND_PER_SEED=40       # sibling rows read per seed, before the relevance gate admits
SNIPPET_CHARS=280

# ─── fusion weights ──────────────────────────────────────────────────────────
#
# ! Properties of the CORPUS, not of the engine, and re-measured after every
# re-chunk. The shipped defaults were fitted on spike-02; a different corpus
# needs its own fit (dev_tools/eval/e2e.py reports it).

# ! DENSE_WEIGHT was 0.0 until 2026-09-19, when the corpus was re-embedded with
# the model's reference implementation (EMBEDDING.md section 5d). 2.0 is the fitted
# value: best Recall@10, near-best Recall@5, and it keeps the lexical arms
# contributing at k=20-50, which is the width a caller is actually handed.
# ! Do NOT fit this on Recall@5 alone. Fusion loses to dense-alone at k=5 and wins
# from k=20 up (EVAL.md section 4b), so a k=5 fit over-weights dense.
DENSE_WEIGHT=2.0
SPARSE_WEIGHT=1.0
TEXT_WEIGHT=1.0

# ─── factor weights ──────────────────────────────────────────────────────────
#
# What MATTERS among what is relevant (docs/SCORING.md §2). A bounded prior on
# the fused score, so none of these can promote what retrieval never found.
#
# Fitted by dev_tools/eval/fit_factors.py: +7.5 points Recall@5 leave-one-out.
# All five at 0 is exactly the identity on the fused order.

# ! A FLOOR, not a weight, and worth more than every weight below combined:
# +12.5 points Recall@5 on its own against +5.0 for the best single factor.
# A candidate must contain this share of the query's content terms to be ranked.
# ! 0.3, not 0.4. 0.4 was fitted against the TEXT ARM ALONE; the engine ranks
# an RRF pool that already contains BM25, and on that pool 0.4 costs 2.5 points
# while 0.3 costs nothing (docs/SCORING.md §3).
RELEVANCE_FLOOR=0.3

# ! Sum = 1.0, so the prior is bounded at 2.00x. That ceiling is enforced at
# startup, and it is not a style preference: the fused pool's own relevance
# spans as little as 1.31x, so a wider prior can lift the last candidate in the
# pool to first on metadata alone (invariant 9).
#
# ! These shipped as 1.0 / 0.5 / 0.25 -- sum 1.75, bound 2.75x -- which is the
# unconstrained fit this project measured and rejected: best Recall@5 of
# anything tried, and an MRR below factors-off, because it hoists a few
# metadata-favoured chunks into the top five and scrambles the rest.
FACTOR_AUTHORITY=0.5      # the published hierarchy: UU > PP > PERDA > PERBUP
FACTOR_STRUCTURAL=0.25    # Pasal over LAMPIRAN; 22.5% of the corpus is annex
FACTOR_TOPICAL=0.25       # subject match — earns its weight once the floor exists
FACTOR_COMPLETENESS=0.0   # measured to add nothing once a real floor exists
FACTOR_TEMPORAL=0.0       # recency — measured to add nothing, kept as a finding

# ---------------------------------------------------------------------------
# Scoring vocabulary and the algorithm registry · both optional, both validated
# at startup, both FATAL if they cannot work (invariant 12).
# ---------------------------------------------------------------------------

# What this corpus's own labels mean. Vera is a retrieval engine, not a legal
# one: `authority` asks how binding a source is and `structural` asks whether a
# chunk is operative text or an appendix. Neither question is Indonesian; only
# the answers are.
#
# ! Unset falls back to the tables of the corpus this engine was first built
# for, and startup SAYS SO. On a corpus those tables do not describe, every one
# of them evaluates neutrally for every row and the FACTOR_* weights above do
# nothing -- silently. Startup refuses rather than serving that.
#
# config/vocabulary.id_regulation.json reproduces the fallback exactly and is
# the worked example. The destination for this data is `corpus_meta`, written
# by Ravel from the profile that already holds the table.
# VOCABULARY_PATH=config/vocabulary.id_regulation.json

# Named ways to rank, selectable per request via `profile`. An agent that
# judges a ranking unfit calls again naming a different one; that retry is the
# escalation mechanism, in place of in-engine viewpoints or effort tiers.
#
# ! An entry with no `fitted` block loads as experimental: reachable by name,
# absent from the tool schema. The agent is never OFFERED a weight vector
# nobody measured.
# ALGORITHMS_PATH=config/algorithms.json

# ─── gates ───────────────────────────────────────────────────────────────────

CANARY_MIN_COSINE=0.98   # startup vector-space check; loosening it is visible
# ! Lowered from 0.45 on 2026-09-19. The old value was fitted to the previous
# vector space and refused 2 of 39 real questions after re-clustering. In the new
# space in-domain centroid scores bottom at 0.396 while out-of-domain reaches 0.493
# — the distributions OVERLAP, so this buys 0 false refusals at the cost of 2 of 6
# out-of-domain queries getting through. The lexical floor below catches the other
# 4. EVAL.md section 4c has the distribution and why a better signal is needed.
DOMAIN_FLOOR=0.39
DOMAIN_LEXICAL_FLOOR=0.40
GATE_SAMPLE=5

# ─── response caps ───────────────────────────────────────────────────────────

READ_CHUNK_CHARS=4000
MAX_PROVENANCE_IDS=50

# ─── infrastructure · read by docker-compose, not by the engine ──────────────
#
# All optional; the defaults shown are what compose falls back to. Documented
# in full in docs/CONFIGURATION.md §8.

# POSTGRES_PORT=5432                  # published on 127.0.0.1 only
# PG_SHARED_BUFFERS=1500MB            # the VPS overlay drops this to 512MB
# PG_EFFECTIVE_CACHE_SIZE=4GB
# PG_MAINTENANCE_WORK_MEM=512MB
# PG_WORK_MEM=32MB
# PG_MAX_CONNECTIONS=32

# EMBED_IMAGE=ghcr.io/huggingface/text-embeddings-inference:86-1.7.2
# EMBED_POOLING=last-token            # must match the model's 1_Pooling/config.json
# EMBED_DTYPE=float16
# EMBED_MAX_BATCH_TOKENS=32768        # the model's full context
# EMBED_PORT=8080

# ENGINE_BIND=127.0.0.1               # ! 0.0.0.0 publishes the corpus
# ENGINE_PORT=8081
# VPS_CPUSET=0,1                      # overlay only; db and engine share a pair
